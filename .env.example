PORT=8787
ADMIN_TOKEN=replace-with-a-long-random-token
HYSTERIA2_TICKET_SECRET=replace-with-at-least-32-random-bytes
HYSTERIA2_TICKET_TTL_SECONDS=45
HYSTERIA2_RESUME_SECONDS=43200
HYSTERIA2_STATS_MAX_AGE_SECONDS=180
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=replace-with-generated-salt
ADMIN_PASSWORD_HASH=replace-with-generated-scrypt-hash
ADMIN_SESSION_HOURS=12
DATABASE_PATH=./data/nivora.db
PANEL_BASE_URL=https://panel.example.com/secret-path
PANEL_API_TOKEN=
PANEL_INBOUND_ID=1
# Comma-separated VLESS Vision/Reality inbounds (same flow as the primary).
PANEL_VISION_INBOUND_IDS=2
# Comma-separated non-Vision transports. Nivora provisions the same UUID/subId
# with an empty flow so one subscription contains every compatible fallback.
PANEL_CDN_INBOUND_IDS=4,5,6,7,8
PANEL_SUBSCRIPTION_BASE_URL=https://sub.example.com/sub/
PUBLIC_BASE_URL=https://vpn.example.com
PANEL_TLS_REJECT_UNAUTHORIZED=true
CARD_NUMBER=
CARD_HOLDER=
SUPPORT_ID=
NODE_ENV=production
BACKUP_DIR=./backups
BACKUP_KEEP=14
# --- ایجنت تأیید خودکار رسید (Auto-review) ---
# راز مشترک وبهوک پیامک؛ اپ SMS-Forwarder روی گوشیِ سیم‌کارت مقصد این را در هدر x-webhook-secret می‌فرستد.
SMS_WEBHOOK_SECRET=
AUTO_REVIEW_ENABLED=true
# اختلاف مجاز مبلغ بین رسید و واریز بانکی (ریال). صفر یعنی تطبیق دقیق.
AUTO_REVIEW_AMOUNT_TOLERANCE_RIAL=0
# چند ساعت قبل از ثبت سفارش هنوز واریز معتبر است.
AUTO_REVIEW_LOOKBACK_HOURS=24
# فاصله‌ی جاروی دوره‌ای سفارش‌های در انتظار (ثانیه).
AUTO_REVIEW_SWEEP_SECONDS=60
# واحد پیش‌فرض پیامک بانک وقتی ریال/تومان صریح نیست.
BANK_SMS_DEFAULT_UNIT=rial
# OCR کمکی برای خواندن شماره پیگیری از عکس رسید (نیازمند نصب tesseract-ocr و بسته fas).
RECEIPT_OCR_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_SENDER=
PASSWORD_RESET_DEBUG_CODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SESSION_DAYS=365
# --- NeuralMesh Lab (test-only signed manifest) ---
# Store only SHA-256(token) on the server. The plaintext test token must never be committed.
NEURALMESH_MANIFEST_TOKEN_HASH=
NEURALMESH_MANIFEST_FILE=/etc/nivora/neuralmesh/manifest.json
NEURALMESH_SIGNING_KEY_FILE=/etc/nivora/neuralmesh/manifest-ed25519.pem
NEURALMESH_MANIFEST_KEY_ID=neuralmesh-lab-v1
