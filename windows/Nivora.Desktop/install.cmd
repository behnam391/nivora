@echo off
setlocal
set "TARGET=%LOCALAPPDATA%\Programs\Nivora VPN"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $target=$env:LOCALAPPDATA+'\Programs\Nivora VPN'; New-Item -ItemType Directory -Force -Path $target|Out-Null; Expand-Archive -LiteralPath '%~dp0Nivora-Desktop-1.2.0.zip' -DestinationPath $target -Force; $shell=New-Object -ComObject WScript.Shell; foreach($link in @($env:APPDATA+'\Microsoft\Windows\Start Menu\Programs\Nivora VPN.lnk',$env:USERPROFILE+'\Desktop\Nivora VPN.lnk')){$shortcut=$shell.CreateShortcut($link);$shortcut.TargetPath=$target+'\Nivora.exe';$shortcut.WorkingDirectory=$target;$shortcut.IconLocation=$target+'\Nivora.exe,0';$shortcut.Save()}; New-Item -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\NivoraVPN' -Force|Out-Null; Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\NivoraVPN' -Name DisplayName -Value 'Nivora VPN'; Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\NivoraVPN' -Name DisplayVersion -Value '1.2.0'; Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\NivoraVPN' -Name DisplayIcon -Value ($target+'\Nivora.exe'); Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\NivoraVPN' -Name UninstallString -Value ('cmd.exe /c ""'+$target+'\uninstall.cmd""'); Start-Process ($target+'\Nivora.exe')"
if errorlevel 1 (echo نصب Nivora انجام نشد.& pause & exit /b 1)
exit /b 0
