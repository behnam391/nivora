# Replace vpn.example.com with the dedicated domain/subdomain for this store.
vpn.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8787
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    log {
        output file /var/log/caddy/nivora-access.log {
            roll_size 50MiB
            roll_keep 10
        }
        format json
    }
}
