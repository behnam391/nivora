[Unit]
Description=Nivora subscription platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nivora
Group=nivora
WorkingDirectory=/opt/nivora
Environment=NODE_ENV=production
EnvironmentFile=/opt/nivora/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nivora/data /opt/nivora/receipts /opt/nivora/backups
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
